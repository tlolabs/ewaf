<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EWAF</AssemblyName><RootNamespace>EWAF</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>../../../assets/icon/ewaf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">$(DefineConstants);INTERNAL_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <AvaloniaResource Include="../../../assets/icon/ewaf.ico" Link="Assets/ewaf.ico" />
    <Content Include="../../../assets/icon/ewaf.ico" Link="Assets/ewaf.ico" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="EWAF.Tests" />
  </ItemGroup>
  <Target Name="RejectUnsupportedDesktop" BeforeTargets="Publish">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' And '$(RuntimeIdentifier)' != 'win-arm64' And '$(RuntimeIdentifier)' != 'linux-x64' And '$(RuntimeIdentifier)' != 'linux-arm64' And '$(RuntimeIdentifier)' != 'osx-arm64'" Text="Unsupported Avalonia target. macOS is ARM64 internal reference only." />
  </Target>
</Project>

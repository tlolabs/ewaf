<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="EWAF.App" RequestedThemeVariant="Default">
 <Application.Styles>
  <FluentTheme />
  <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="34" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="34" /></Style>
  <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
 </Application.Styles>
</Application>
